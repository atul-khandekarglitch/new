# Supabase Public Configuration (Frontend)
# Compatible with both standard Vite and Next.js public variable prefixes
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Backend-only secrets: never expose these through client/browser variables
SUPABASE_SERVICE_ROLE_KEY=your_server_side_service_role_key

# Configure only if live payment provider integration is implemented
PAYMENT_PROVIDER_SECRET_KEY=your_payment_secret_key
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret
